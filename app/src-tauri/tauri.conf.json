{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Freeport",
  "version": "0.1.0",
  "identifier": "dev.freeport.app",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:5273",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Freeport",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 16 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "HanoCode",
    "copyright": "© 2026 HanoCode and Freeport contributors · AGPL-3.0-or-later",
    "category": "DeveloperTool",
    "shortDescription": "Local gateway that unifies free LLM providers",
    "longDescription": "Freeport discovers free model tiers you already have access to, routes requests across them with a three-stage gate, and injects the gateway into the coding agents you already use. Everything runs on 127.0.0.1: credentials are encrypted at rest, logs never leave the machine, and every injected file can be rolled back byte-for-byte.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../../docs/EULA.md": "EULA.md"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": false
  }
}
